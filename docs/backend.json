
{
  "entities": {
    "UserProfile": {
      "title": "Kullanıcı Profili",
      "description": "Öğrenci, Öğretmen ve Yönetici bilgilerini, rollerini ve hedef sınavlarını saklar.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "teacher", "school_admin", "admin"] },
        "targetExam": { "type": "string", "description": "Kullanıcının hazırlandığı sınav (LGS, YKS, KPSS vb.)" },
        "coachId": { "type": "string", "description": "Öğrenciye atanan koçun UID'si." },
        "activationCode": { "type": "string", "description": "Öğretmenler için benzersiz aktivasyon kodu." },
        "school": { "type": "string" },
        "grade": { "type": "string" },
        "branch": { "type": "string" },
        "bio": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "CoachingSession": {
      "title": "Koçluk Seansı",
      "description": "Koç ve öğrenci arasındaki planlanmış görüşmeler.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "teacherId": { "type": "string" },
        "scheduledAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["scheduled", "completed", "cancelled"] },
        "notes": { "type": "string" }
      },
      "required": ["studentId", "teacherId", "scheduledAt"]
    },
    "Task": {
      "title": "Görev",
      "description": "Koç tarafından öğrenciye atanan hedefler.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "teacherId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "dueDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "completed"] }
      },
      "required": ["studentId", "title", "status"]
    }
  },
  "auth": {
    "providers": ["email", "google"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Kullanıcılar bu koleksiyonda saklanır."
    },
    "/sessions/{sessionId}": {
      "schema": "CoachingSession",
      "description": "Görüşme kayıtları."
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Öğrenci görevleri."
    }
  }
}
