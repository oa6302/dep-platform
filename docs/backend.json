
{
  "entities": {
    "UserProfile": {
      "title": "Kullanıcı Profili",
      "description": "Öğrenci, Öğretmen ve Yönetici bilgilerini saklar.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "teacher", "admin"] },
        "targetExam": { "type": "string" },
        "points": { "type": "number" },
        "badges": { "type": "object" },
        "completedTopics": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "StudyPlan": {
      "title": "Çalışma Planı",
      "description": "Fasikül planı ve günlük görevler.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "masterPlan": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "TestResult": {
      "title": "Test Sonucu",
      "description": "Öğrencinin çözdüğü testlerin detayları.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "lesson": { "type": "string" },
        "topic": { "type": "string" },
        "totalQuestions": { "type": "number" },
        "correct": { "type": "number" },
        "wrong": { "type": "number" },
        "net": { "type": "number" },
        "testDate": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["email", "google"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Kullanıcı profilleri."
    },
    "/studyPlans/{userId}": {
      "schema": "StudyPlan",
      "description": "Kullanıcı çalışma planları."
    },
    "/testResults/{resultId}": {
      "schema": "TestResult",
      "description": "Test ve deneme sonuçları."
    }
  }
}
