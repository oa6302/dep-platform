
{
  "entities": {
    "UserProfile": {
      "title": "Kullanıcı Profili",
      "description": "Öğrenci, Öğretmen ve Yönetici bilgilerini, rollerini ve akademik profilini saklar.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "teacher", "school_admin", "admin"] },
        "targetExam": { "type": "string" },
        "studentProfile": {
          "type": "object",
          "properties": {
            "levels": { "type": "object" },
            "dailyCapacity": { "type": "number" },
            "questionCapacity": { "type": "number" },
            "weakSubjects": { "type": "array", "items": { "type": "string" } },
            "restDay": { "type": "string" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "StudyPlan": {
      "title": "Çalışma Planı",
      "description": "Adaptif 364 günlük program ve konu başarı takibi.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "startDate": { "type": "string" },
        "masterPlan": { "type": "array" },
        "topicProgress": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "masterPlan"]
    },
    "StudyEntry": {
      "title": "Tamamlanan Çalışma Kaydı",
      "description": "Öğrencinin tamamladığı her bir seansın logu.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "topic": { "type": "string" },
        "xp": { "type": "number" },
        "questionCount": { "type": "number" },
        "accuracy": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["email", "google"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Kullanıcı profilleri."
    },
    "/studyPlans/{userId}": {
      "schema": "StudyPlan",
      "description": "Adaptif akademik programlar."
    },
    "/studies/{studyId}": {
      "schema": "StudyEntry",
      "description": "Çalışma logları."
    }
  }
}
